name = "Pilum FF"
tech_title = "XSTR("Pilum Friend-or-Foe", -1)"
tech_description = "XSTR(\"The Pilum friend-or-foe (FF) missile was developed once ship systems were able to distinguish between friendly and enemy ships. Capable of identifying the distinctive Confederation ship signal, it makes a beeline for the nearest ship that isn't broadcasting that signal. This has resulted in the destruction of several Terran ships whose communications systems were damaged. In spite of this inherent danger, both sides continue to use the FF as standard armament for medium and heavy fighters. This missile doesn't require a lock, and it will acquire a new target if the current one is destroyed before detonation..\", -1)"
