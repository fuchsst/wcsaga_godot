[resource]
script = ExtResource("1_resource")
year = 2669
order_index = 117
era = "Victory of 2669"
title = "Wing Commander: Privateer"
short_description = "The Gemini Sector frontier. Burrows navigates pirates, raiders, and the fanatical Retros."
long_description = "While the main war rages in the Enigma and Vega sectors, the Gemini Sector (a frontier region) faces a different crisis. The player character, Burrows (canonically established as having the callsign 'Privateer' or 'Brownhair'), navigates a landscape of pirates, Kilrathi raiders, and the Retros (Church of Man), a fanatical anti-technology cult led by Mordecai Jones. The Steltek Incident: Burrows discovers a derelict alien fighter from an ancient race called the Steltek. The ship possesses a weapon (the Steltek Gun) capable of destroying anything. The narrative involves preventing this technology from falling into Kilrathi hands. The expansion Righteous Fire (1994) takes place 'one year later,' suggesting that disorder in Gemini persisted even after the Kilrah armistice."
locked = true
