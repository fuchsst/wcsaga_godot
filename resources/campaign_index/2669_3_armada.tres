[resource]
script = ExtResource("1_resource")
year = 2669
order_index = 300
era = "Victory of 2669"
title = "Wing Commander: Armada"
short_description = "A lost patrol. The TCS Lexington and KIS Shiraak engage in deep space cat-and-mouse warfare."
long_description = "Armada depicts a 'lost patrol' scenario. The TCS Lexington (CV-44) and the Kilrathi carrier KIS Shiraak are engaged in a cat-and-mouse chase deep in unmapped space. This campaign likely occurs concurrently with the desperate months of 2669, representing another arm of the Confederation's 'total effort' strategy to find a flank into Kilrathi territory. The 'Voices of War' manual provides crucial dates for the timeline, including the 2668 Battle of Earth aftermath. The Lexington later becomes pivotal in the Border Worlds conflict of Wing Commander IV."
locked = true
