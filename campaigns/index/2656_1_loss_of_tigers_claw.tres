[resource]
script = ExtResource("1_resource")
year = 2656
order_index = 1
era = "Dark Years Era"
title = "The Loss of the Tiger's Claw"
short_description = "The 'Queen of the Fleet' is destroyed in the K'Tithrak Mang system. Blair is blamed and exiled."
long_description = "The loss of the Tiger's Claw in the K'Tithrak Mang system changes the trajectory of the war. Blamed on 'stealth fighters' that no sensors can record, the destruction is pinned on Blair's negligence. He is demoted and exiled to the TCS Austin, marking a decade of stagnation for the Confederation while the Kilrathi advance. The death of the legendary carrier marks the end of the Golden Age and the beginning of the Dark Years."
locked = true
