[resource]
script = ExtResource("1_resource")
year = 2681
order_index = 2
era = "Nephilim Era"
title = "Wing Commander: Secret Ops"
short_description = "The TCS Cerberus hunts Nephilim remnants. Cleanup operations in the Proxima and Sol sectors."
long_description = "The TCS Cerberus, a Hades-class Quick Strike Cruiser, is dispatched to hunt down Nephilim remnants that escaped the wormhole closure. The narrative focuses on the strategic mobility of the Cerberus and the defense of the Proxima and Sol sectors from Nephilim infiltration. Unlike the massive Midway, the Cerberus represents a more agile response to the threat. The game deals with the aftermath of the main invasion, showing how humanity deals with scattered Nephilim forces that continue to pose a threat even after the primary wormhole is closed."
locked = false
campaign_root_scene = null
