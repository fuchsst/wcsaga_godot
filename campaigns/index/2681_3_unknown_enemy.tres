[resource]
script = ExtResource("1_resource")
year = 2681
order_index = 3
era = "Nephilim Era"
title = "Wing Commander: Unknown Enemy"
short_description = "The Border Worlds perspective. The BWS Dauntless fights the Nephilim with scrap and determination."
long_description = "Unknown Enemy offers the critical 'Border Worlds Perspective' of the Nephilim War. While the Midway and Cerberus receive the glory and funding, the Border Worlds Militia must fight the same aliens with scrap. The player serves on the BWS Dauntless, an aging Bengal-class carrier (sister ship to the Tiger's Claw) commanded by Captain 'Quarto' and Commander 'Pedro'. The Dauntless was slated for the scrapyard when the invasion hit. The campaign involves utilizing the 'Manta' and 'Viper' fighters—Border Worlds militia tech—against the advanced Nephilim biological ships. The narrative tragedy is the lack of support from the Confederation; the Dauntless fights a lonely war in the shadow of the Midway's operations."
locked = false
campaign_root_scene = null
