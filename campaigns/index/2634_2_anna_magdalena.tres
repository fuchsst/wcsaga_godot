title = "The Anna Magdalena Tragedy"
short_description = "The destruction of a civilian transport carrying orphans catalyzes the Declaration of War."
long_description = "The Anna Magdalena, a transport ferrying orphans, is destroyed by Kilrathi fighters. This tragedy becomes the final catalyst for the Terran Confederation Congress to declare war on the Empire of Kilrah. The massacre of innocents unites humanity against the alien threat."
