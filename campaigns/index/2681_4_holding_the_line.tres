[resource]
script = ExtResource("1_resource")
year = 2681
order_index = 300
era = "Nephilim Era"
title = "Holding The Line"
short_description = "The Reserve Fleets stand firm. Documenting the battles fought away from the spotlight."
long_description = "Holding The Line is a massive collaborative text project that documents the battles fought by the units not on the front line with Casey. It details the defense of the localized systems by the Confederation Reserve and the Landreich. It provides the 'strategic depth' to the Nephilim war, showing that the invasion was a sector-wide flood, not a single spearhead. This fan fiction project paints a picture of a galaxy-wide conflict where countless brave pilots and crews fought and died in battles that never made the history books, holding the line against an alien menace while the great carriers got the glory."
locked = true
